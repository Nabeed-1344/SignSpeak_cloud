  "type": "module",
  "bugs": {
    "url": "https://github.com/Nabeed-1344/SignSpeak_cloud/issues"
  },
  "homepage": "https://github.com/Nabeed-1344/SignSpeak_cloud#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
