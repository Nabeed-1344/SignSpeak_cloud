{
  "name": "signspeak_cloud",
  "version": "1.0.0",
  "description": "Flask web app that shows a live webcam feed in the browser.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint static/js",
    "format:check": "prettier --check static/js/**/*.js eslint.config.js package.json .prettierrc.json",
